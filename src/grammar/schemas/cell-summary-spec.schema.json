{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screengrid.dev/grammar/schemas/cell-summary-spec.schema.json",
  "title": "SemanticCellSummarySpec",
  "type": "object",
  "required": ["name", "role", "op"],
  "properties": {
    "name": { "type": "string" },
    "role": {
      "enum": ["primary", "denominator", "composition", "profile", "uncertainty", "reliability", "provenance"]
    },
    "field": { "type": ["string", "null"] },
    "op": { "enum": ["count", "sum", "mean", "min", "max", "mode", "distinct", "variance", "missingness", "category-distribution", "time-series"] },
    "per": {
      "type": "object",
      "description": "Denominator semantics: what this summary is expressed per. Makes rate/share claims explicit and checkable.",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "count", "field", "area", "external"] },
        "field": { "type": "string", "description": "Required when type is \"field\": summed per cell as the denominator." },
        "value": { "type": "number", "description": "Required when type is \"external\": a fixed reference value." },
        "description": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "reliability": {
      "type": "object",
      "properties": {
        "warnBelowCount": { "type": "integer", "minimum": 0 },
        "warnOnMissingness": { "type": "boolean" },
        "warnOnHeterogeneity": { "type": "boolean" }
      }
    },
    "comparability": {
      "type": "object",
      "properties": {
        "normalization": {
          "enum": ["max-local", "max-global", "z-score", "percentile"],
          "description": "Uses the same vocabulary as screengrid.normalization and the library's NormalizationFunctionRegistry."
        },
        "validAcrossZoom": { "type": "boolean" },
        "requiresDenominator": { "type": "boolean" }
      }
    }
  }
}
