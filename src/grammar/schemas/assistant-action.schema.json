{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screengrid.dev/demo/schema/assistant-action.schema.json",
  "title": "AssistantActionProposal",
  "type": "object",
  "required": ["summary", "rationale", "actions", "warnings"],
  "properties": {
    "summary": { "type": "string" },
    "rationale": { "type": "string" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "confidence", "patch"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "patch": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["op", "path"],
              "properties": {
                "op": { "enum": ["add", "replace", "remove"] },
                "path": { "type": "string", "pattern": "^/" },
                "value": {}
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

